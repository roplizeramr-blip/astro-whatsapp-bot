# ═══════════════════════════════════════════════════════════════
#  🔐 نموذج الإعدادات — انسخ هذا الملف إلى .env وعمّر القيم
#
#  cp .env.example .env
#
#  ⚠️ .env مستثنى من git — لا ترفعه أبداً.
#  ⚠️ لا تضع أي مفتاح API في config.js — يُرفع مع الكود إلى GitHub.
# ═══════════════════════════════════════════════════════════════

# ── 🔑 الذكاء الاصطناعي (إجباري للردود) ──
# مفاتيح Groq، عدة مفاتيح مفصولين بفاصلة (للتحميل والتبديل التلقائي)
GROQ_API_KEYS=
GROQ_MODEL=qwen/qwen3.8-27b

# ── 🔑 Gemini Live (إجباري للمكالمات الصوتية) ──
# بدونه سيرفر المكالمات (voip-server) يخرج بخطأ.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live
# تركه فارغ = تلقائي. يقبل فقط low|medium|high وعلى موديلات extended-thinking فقط.
GEMINI_THINKING=

# ── 🤖 هوية البوت ──
BOT_NAME=ASTRO BOT
BOT_PREFIX=.
OWNER_PHONE=201044626335
# OWNERS = أرقام المالكين مفصولين بفاصلة
OWNERS=

# ── 📞 رقم البوت وإعدادات المكالمات ──
# رقم البوت (الصيغة الدولية بدون +) — خاص متغير البيئة ديال المنصة
BOT_NUMBER=201226110887
VOIP_PORT=8090
VOIP_MAX_CALL_MS=600000
# اتركه فارغ ليستخدم التحية الافتراضية
VOIP_GREETING=
# 🔀 المسار العام للوحة المكالمات (reverse proxy داخل البوت)
#    فـ السحابة المنصة كتفتح غير بورت واحد — إذن كايصوّبو /voip → 8090
#    المتصفح كيشوف: https://your-app.cranl.net/voip
#    محلياً: '' (الصفحة على 8090 مباشرة)
VOIP_MOUNT=
# 🌐 رابط عام للوحة المكالمات — اتركه فارغ فـ العادة.
#   VoIP_MOUNT كافي: البوت كيدير proxy على نفس الدومين.
#    حط هنا رابط غير إلا المنصة كتكشف 8090 للعموم.
VOIP_PUBLIC_URL=

# 🚦 للتطوير المحلي فقط — حط 1 باش تجبر التطبيق يستعمل localhost:8090
#    حتى لو كان CRANL_APP_URL موجود فـ .env
#    ⚠️ حيدو ولا حط 0 على المنصة — ما تحطش 1 هناك!
FORCE_LOCAL=

# ── 🌐 البوت الرايسي ──
PORT=8080
DASH_PORT=
DASH_TOKEN=
PAIRING_PHONE=

# ── 🧠 النطق والتحويل ──
STT_MODEL=whisper-large-v3
TTS_VOICE=neymar

# ── 💾 التخزين ──
# اتركه فارغ محلياً. على المنصة حط رابط PostgreSQL.
DATABASE_URL=

# ── 🚀 المنصة ──
# منصة النشر — تُقرأ من scripts/cranl-config.js
CRANL_APP_ID=
CRANL_APP_URL=
API_BASE_URL=